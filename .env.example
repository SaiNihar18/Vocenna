# ==========================================
# VOCENNA ENVIRONMENT CONFIGURATION
# ==========================================

# Core Application Settings
PROJECT_NAME="Vocenna"
ENVIRONMENT="local" # Options: local, staging, production
DEBUG=True
API_V1_STR="/api/v1"
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000"]

# Security & JWT Auth
# Generate a strong 32-byte key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="change_this_super_secret_key_in_production_32bytes_min"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=43200 # 30 days for dev

# PostgreSQL + pgvector Configuration
# Standard connection string format: postgresql+asyncpg://user:pass@host:port/dbname
POSTGRES_USER="vocenna"
POSTGRES_PASSWORD="vocenna_password"
POSTGRES_DB="vocenna_db"
POSTGRES_HOST="postgres"
POSTGRES_PORT=5432
DATABASE_URL="postgresql+asyncpg://vocenna:vocenna_password@postgres:5432/vocenna_db"
# Sync Database URL for Alembic migrations
SYNC_DATABASE_URL="postgresql+psycopg2://vocenna:vocenna_password@postgres:5432/vocenna_db"

# Redis Configuration
REDIS_HOST="redis"
REDIS_PORT=6379
REDIS_URL="redis://redis:6379/0"

# Celery Message Broker & Result Backend
CELERY_BROKER_URL="redis://redis:6379/0"
CELERY_RESULT_BACKEND="redis://redis:6379/0"

# AI & Speech Service Drivers
# STT Drivers: "whisper_local" (faster-whisper) or "cloud_api" (OpenAI Whisper API)
STT_SERVICE_TYPE="whisper_local"
WHISPER_MODEL_SIZE="base" # tiny, base, small, medium, large-v3

# LLM Drivers: "ollama" (Local Ollama), "huggingface" (HF pipeline), or "cloud_api" (OpenAI / Anthropic)
LLM_SERVICE_TYPE="ollama"
OLLAMA_BASE_URL="http://host.docker.internal:11434"
OLLAMA_MODEL="llama3"

# Optional Cloud API Keys (Used when STT_SERVICE_TYPE or LLM_SERVICE_TYPE is set to "cloud_api")
# Instructions:
# - OpenAI: Sign up at https://platform.openai.com, navigate to API keys, create secret key.
# - HuggingFace: Sign up at https://huggingface.co, Settings -> Access Tokens, create Read token (required for pyannote speaker diarization).
OPENAI_API_KEY=""
HUGGINGFACE_HUB_TOKEN=""
